# Local demo credentials. Do not use them outside this machine.
# The Go processes read the environment only. Copying this file to .env does not
# export the variables; the shell has to source it with set -a.
# Compose uses API_PORT for the published API port. Example: API_PORT=18080 docker compose up
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://scheduler:scheduler@127.0.0.1:5432/scheduler?sslmode=disable
NATS_URL=nats://127.0.0.1:4222
SCHEDULER_INTERVAL=1s
SCHEDULER_BATCH=100
OUTBOX_INTERVAL=500ms
OUTBOX_BATCH=50
LOG_LEVEL=info
WORKER_ID=
