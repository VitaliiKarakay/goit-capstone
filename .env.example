# Local demo credentials. Do not use outside this machine.
# Go binaries read the environment only; copy this file to .env and run: set -a && source .env && set +a
# Compose publishes the API on 127.0.0.1:${API_PORT:-8080}
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://scheduler:scheduler@127.0.0.1:5432/scheduler?sslmode=disable
NATS_URL=nats://127.0.0.1:4222
SCHEDULER_INTERVAL=1s
SCHEDULER_BATCH=100
OUTBOX_INTERVAL=500ms
OUTBOX_BATCH=50
RECOVERY_INTERVAL=5s
RECOVERY_BATCH=50
MAX_CLAIM_ATTEMPTS=5
LOG_LEVEL=info
WORKER_LEASE_DURATION=45s
WORKER_LEASE_RENEW_INTERVAL=10s
WORKER_SEND_TIMEOUT=90s
WORKER_ID=
METRICS_ADDR=127.0.0.1:9091
MOCK_SEND_DELAY=0s
MOCK_FAILURE_RATE=0
METRICS_DB_REFRESH_INTERVAL=10s
