# Local demo credentials. Do not use outside this machine.
# Go binaries read the environment only; copy this file to .env and run: set -a && source .env && set +a
# Compose publishes the API on 127.0.0.1:${API_PORT:-8080}
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://scheduler:scheduler@127.0.0.1:5432/scheduler?sslmode=disable
NATS_URL=nats://127.0.0.1:4222
SCHEDULER_INTERVAL=1s
SCHEDULER_BATCH=100
OUTBOX_INTERVAL=500ms
OUTBOX_BATCH=50
LOG_LEVEL=info
WORKER_ID=
